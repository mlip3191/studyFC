# Copy this file to .env and fill in your keys:   cp .env.example .env
# .env is gitignored. Never commit it, paste it in chat, or share it.

# --- Anthropic (Claude): the ONLY provider this app uses today ---------------
# Get a key: https://console.anthropic.com/  ->  API keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Other providers: PLACEHOLDERS ONLY --------------------------------------
# The app does not read these. They are here so that, if support is added later,
# all keys live in one file. Leave them empty or delete these lines.
OPENAI_API_KEY=your-openai-api-key-here
XAI_API_KEY=your-xai-grok-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# --- App settings -------------------------------------------------------------
# Relative paths are resolved from the repo root.
DECKS_DIR=./decks
MAX_UPLOAD_MB=25
